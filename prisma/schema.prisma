generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntityStatus {
  Active
  Inactive
  Prospect
}

enum LeadStatus {
  New
  Contacted
  Qualified
  Proposal
  Negotiation
  ClosedWon
  ClosedLost
  Converted
  Disqualified
}

enum PipelineStageName {
  Discovery
  Qualification
  Proposal
  Negotiation
  ClosedWon
  ClosedLost
}

enum ActivityType {
  Call
  Email
  Meeting
  Task
  Note
  Comment
}

enum ActivityStatus {
  Planned
  Completed
  Cancelled
}

enum TicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

enum TicketPriority {
  Low
  Medium
  High
  Critical
}

enum NotificationType {
  Info
  Warning
  Success
  Error
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum CallOutcome {
  NoAnswer
  Voicemail
  Contacted
  Interested
  FollowUp
  NotInterested
  InvalidNumber
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  name       String?
  image      String?
  role       String     @default("VIEWER")
  department String?
  team       String?
  status     String     @default("Active")
  lastLogin  DateTime?
  assignedAt DateTime   @default(now())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // SaaS multi-tenancy — every user belongs to exactly one Organization.
  // Resolution key is the authenticated Microsoft tenant id (tid), never the
  // email domain. Backfilled to the default organization for legacy rows.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Onboarding preferences
  onboardingStartedAt      DateTime?
  onboardingCompletedAt    DateTime?
  onboardingDismissedAt    DateTime?
  onboardingNeverShowAgain Boolean  @default(false)
  onboardingLastStep       Int      @default(1)

  memberships          OrganizationMember[]
  subscriptionChanges  SubscriptionChange[] @relation("SubscriptionChangeBy")
  subscriptionsGranted Subscription[]       @relation("SubscriptionGrantedBy")
  onboardingState      OnboardingState?
  salesInquiries       SalesInquiry[]       @relation("SalesInquiryReviewedBy")
  createdOrganizations Organization[]       @relation("OrganizationCreatedBy")

  assignedLeads          Lead[]
  assignedTickets        Ticket[]
  activities             Activity[]
  calendarEvents         CalendarEvent[]
  calendarSyncJobs       CalendarSyncJob[]
  calendarDeltaState     CalendarDeltaState[]
  webhookSubscriptions   WebhookSubscription[]
  graphToken             GraphToken?
  reminders              Reminder[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  createdDocuments       Document[]
  stageChanges           OpportunityStageHistory[] @relation("StageChangeBy")
  opportunities          Opportunity[]
  convertedLeads         Lead[]                    @relation("LeadConvertedBy")
  notes                  Note[]
  assignmentsReceived    Assignment[]             @relation("AssignmentAssignee")
  assignmentsAssigned    Assignment[]             @relation("AssignmentAssignedBy")
  quotesCreated          Quote[]
  invoicesCreated        Invoice[]
  prospectingLists       ProspectingList[]
  prospects              Prospect[]
  campaignsCreated       CallCampaign[]
  callQueueEntries       CallQueueEntry[]
  salesGoals             SalesGoal[]
  automationsCreated     Automation[]
  createdReports         Report[]

  @@index([organizationId])
}

enum LifecycleStage {
  Lead
  Prospect
  Qualified
  Customer
  FormerCustomer
  Partner
}

model Company {
  id            String   @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  companyName   String
  industry      String?
  website       String?
  email         String?
  phone         String?
  country       String?
  city          String?
  address       String?
  employeeCount Int?
  size          String?
  revenue       String?
  status        String   @default("Active")
  lifecycleStage LifecycleStage @default(Prospect)
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts  Contact[]
  customers Customer[]
  documents Document[]
  quotes    Quote[]
  invoices  Invoice[]
  activities Activity[]

  @@index([organizationId])
}

model Customer {
  id        String       @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name      String
  email     String?
  phone     String?
  status    EntityStatus @default(Active)
  companyId String?
  company   Company?     @relation(fields: [companyId], references: [id])
  position  String?
  notes     String?
  tags      Json         @default("[]")
  lifecycleStage LifecycleStage @default(Customer)
  // Migration path: link Customer records to Contact records (no Prisma relation to avoid circular deps)
  contactId String?
  archivedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  opportunities   Opportunity[]
  tickets         Ticket[]
  activities      Activity[]
  documents       Document[]
  leads           Lead[]
  calendarEvents  CalendarEvent[]
  quotes          Quote[]
  invoices        Invoice[]

  @@index([organizationId])
}

model Contact {
  id        String   @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  firstName String
  lastName  String
  email     String?
  phone     String?
  position  String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  country   String?
  city      String?
  notes     String?
  tags      Json     @default("[]")
  status    String   @default("Active")
  lifecycleStage LifecycleStage @default(Prospect)
  linkedIn  String?
  // Buyer role in the deal cycle (Decision Maker, Champion, Influencer, ...).
  role      String?
  lastContactedAt DateTime?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Lead {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  firstName       String
  lastName        String
  title           String?
  email           String?
  phone           String?
  companyName     String?
  source          String?
  status          LeadStatus   @default(New)
  assignedToId    String?
  assignedTo      User?        @relation(fields: [assignedToId], references: [id])
  probability     Int          @default(0)
  expectedRevenue Float        @default(0)
  expectedCloseDate DateTime?
  convertedAt     DateTime?
  convertedById   String?
  convertedBy     User?        @relation("LeadConvertedBy", fields: [convertedById], references: [id])
  opportunityId   String?      @unique
  opportunity     Opportunity? @relation("LeadConversion", fields: [opportunityId], references: [id])
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id])
  score           Int          @default(0)
  isFavorite      Boolean      @default(false)
  notes           String?
  tags            Json         @default("[]")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  archivedAt      DateTime?

  activities    Activity[]
  tagLinks      LeadTag[]
  reminders     Reminder[]
  documents     Document[]
  quotes        Quote[]
  invoices      Invoice[]
  calendarEvents CalendarEvent[]
  convertedFromProspect Prospect?

  @@index([assignedToId])
  @@index([status])
  @@index([organizationId])
}

model PipelineStage {
  id        String            @id @default(uuid())
  name      PipelineStageName @default(Discovery)
  order     Int               @default(0)
  createdAt DateTime          @default(now())

  opportunities    Opportunity[]
  stageHistoryFrom OpportunityStageHistory[] @relation("FromStage")
  stageHistoryTo   OpportunityStageHistory[] @relation("ToStage")
}

model Opportunity {
  id                String         @id @default(uuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id])
  title             String
  value             Float          @default(0)
  probability       Int            @default(0)
  priority          String         @default("Medium")
  stageId           String?
  stage             PipelineStage? @relation(fields: [stageId], references: [id])
  customerId        String?
  customer          Customer?      @relation(fields: [customerId], references: [id])
  lead              Lead?          @relation("LeadConversion")
  expectedCloseDate DateTime?
  notes             String?
  status            String         @default("Open")
  // Win/loss tracking — set when a deal is closed (Closed Won / Closed Lost).
  wonReason         String?
  lostReason        String?
  closedAt          DateTime?
  ownerId           String?
  owner             User?          @relation(fields: [ownerId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  archivedAt        DateTime?

  stageHistory   OpportunityStageHistory[]
  activities     Activity[]
  documents      Document[]
  calendarEvents CalendarEvent[]
  quotes         Quote[]
  invoices       Invoice[]

  @@index([stageId])
  @@index([ownerId])
  @@index([organizationId])
}

model OpportunityStageHistory {
  id            String         @id @default(uuid())
  opportunityId String
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id])
  fromStageId   String?
  fromStage     PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id])
  toStageId     String
  toStage       PipelineStage  @relation("ToStage", fields: [toStageId], references: [id])
  changedById   String?
  changedBy     User?          @relation("StageChangeBy", fields: [changedById], references: [id])
  createdAt     DateTime       @default(now())

  @@index([opportunityId])
}

model Activity {
  id            String         @id @default(uuid())
  organizationId String
  organization  Organization   @relation(fields: [organizationId], references: [id])
  type          ActivityType   @default(Note)
  subject       String
  description   String?
  status        ActivityStatus @default(Planned)
  priority      String         @default("Normal")
  dueDate       DateTime?
  completedAt   DateTime?
  leadId        String?
  lead          Lead?          @relation(fields: [leadId], references: [id])
  opportunityId String?
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id])
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  ticketId      String?
  ticket        Ticket?        @relation(fields: [ticketId], references: [id])
  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id])
  assigneeId    String?
  assignee      User?          @relation(fields: [assigneeId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([leadId])
  @@index([companyId])
  @@index([createdAt])
  @@index([organizationId])
}

model CalendarEvent {
  id               String   @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  title            String
  description      String?
  startTime        DateTime
  endTime          DateTime
  allDay           Boolean  @default(false)
  location         String?
  graphSyncStatus  String   @default("NOT_SYNCED")
  reminderMinutes  Int      @default(0)

  // --- Microsoft Graph synchronization state (Phase 5) ---
  // Graph event ID (unique — used for duplicate prevention + bidirectional
  // matching). changeKey detects upstream edits for delta sync.
  graphEventId     String?  @unique
  changeKey        String?
  // Preserved from the Graph event so round-trips keep the user's timezone.
  timeZone         String   @default("UTC")
  // Attendees + organizer serialized as JSON so they survive round-trips.
  attendees        Json?
  organizer        Json?
  onlineMeetingUrl String?
  lastSyncedAt     DateTime?
  syncError        String?
  syncAttempts     Int      @default(0)

  leadId           String?
  lead             Lead?    @relation(fields: [leadId], references: [id])
  opportunityId    String?
  opportunity      Opportunity? @relation(fields: [opportunityId], references: [id])
  customerId       String?
  customer         Customer?   @relation(fields: [customerId], references: [id])
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  syncJobs CalendarSyncJob[]

  @@index([userId])
  @@index([startTime])
  @@index([graphEventId])
  @@index([organizationId])
}

/**
 * Retry queue for Microsoft Graph calendar operations. Rows are created when a
 * push/pull fails and re-processed by the background sync runner with backoff.
 */
model CalendarSyncJob {
  id            String   @id @default(uuid())
  eventId       String
  event         CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        String   // "create" | "update" | "delete"
  status        String   @default("pending") // pending | processing | succeeded | failed
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  lastError     String?
  nextAttemptAt DateTime @default(now())
  lastRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([eventId])
}

/**
 * Per-user Microsoft Graph delta-sync cursor. Stores the Graph delta link so
 * pulls resume where they left off instead of re-scanning the whole calendar.
 */
model CalendarDeltaState {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deltaLink  String?
  lastSyncAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

/**
 * Microsoft Graph change-notification subscription (webhook) persisted per
 * user + resource so the UI can show/renew/delete the active subscription.
 */
model WebhookSubscription {
  id                  String    @id @default(uuid())
  graphSubscriptionId String    @unique
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource            String    @default("/me/events")
  expirationDateTime  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
}

/**
 * Server-side copy of the user's Microsoft refresh token, encrypted at rest.
 * Written by the Auth.js jwt callback on sign-in and on every token refresh.
 * Used by background/webhook sync workers that have no browser session.
 */
model GraphToken {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Reminder {
  id            String   @id @default(uuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  title         String
  dueDate       DateTime
  completed     Boolean  @default(false)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, completed])
  @@index([leadId])
  @@index([organizationId])
}

model Notification {
  id            String           @id @default(uuid())
  organizationId String
  organization  Organization     @relation(fields: [organizationId], references: [id])
  type          NotificationType @default(Info)
  title         String
  message       String?
  read          Boolean          @default(false)
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  entityType    String?
  entityId      String?
  actionLink    String?
  createdAt     DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([organizationId])
}

model Ticket {
  id            String         @id @default(uuid())
  organizationId String
  organization  Organization   @relation(fields: [organizationId], references: [id])
  title         String
  description   String?
  status        TicketStatus   @default(Open)
  priority      TicketPriority @default(Medium)
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  assigneeId  String?
  assignee    User?          @relation(fields: [assigneeId], references: [id])
  sla         String?
  requester   String?
  department  String?
  comments    Int            @default(0)
  attachments Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  activities Activity[]

  @@index([status])
  @@index([assigneeId])
  @@index([organizationId])
}

model Document {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  type            String?
  mimeType        String?
  size            Int?
  checksum        String?
  storageProvider String       @default("supabase")
  category        String?
  description     String?
  tags            Json         @default("[]")
  version         String?
  status          String       @default("Active")
  url             String?
  storageKey      String?
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id])
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  leadId          String?
  lead            Lead?        @relation(fields: [leadId], references: [id])
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id])
  uploadedById    String?
  uploadedBy      User?        @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  archivedAt      DateTime?

  @@index([leadId])
  @@index([customerId])
  @@index([organizationId])
}

model AuditLog {
  id            String   @id @default(uuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  entityType    String
  entityId      String
  action        String
  description   String?
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  data          Json?
  before        Json?
  after         Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([organizationId])
}

model Tag {
  id            String   @id @default(uuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  name          String
  color         String?
  category      String?
  createdAt     DateTime @default(now())

  leadLinks LeadTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model LeadTag {
  id      String @id @default(uuid())
  leadId  String
  tagId   String
  lead    Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([leadId, tagId])
  @@index([tagId])
}

model Note {
  id            String   @id @default(uuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  entityType    String
  entityId      String
  content       String
  authorId      String?
  author        User?    @relation(fields: [authorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([organizationId])
}

model Assignment {
  id            String   @id @default(uuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  title         String
  description   String?
  entityType    String
  entityId      String
  assigneeId    String?
  assignee      User?    @relation("AssignmentAssignee", fields: [assigneeId], references: [id])
  assignedById  String?
  assignedBy    User?    @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  dueDate       DateTime?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([organizationId])
}

model Quote {
  id            String      @id @default(uuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  quoteNumber   String      @unique
  status        QuoteStatus @default(DRAFT)
  currency      String      @default("USD")
  subtotal      Float       @default(0)
  tax           Float       @default(0)
  discount      Float       @default(0)
  total         Float       @default(0)
  validUntil    DateTime?
  notes         String?
  leadId        String?
  lead          Lead?       @relation(fields: [leadId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  companyId     String?
  company       Company?    @relation(fields: [companyId], references: [id])
  createdById   String?
  createdBy     User?       @relation(fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  archivedAt    DateTime?

  items    QuoteItem[]
  invoices Invoice[]

  @@index([leadId])
  @@index([opportunityId])
  @@index([organizationId])
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name        String  @default("")
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  amount      Float   @default(0)
}

model Invoice {
  id            String        @id @default(uuid())
  organizationId String
  organization  Organization  @relation(fields: [organizationId], references: [id])
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("USD")
  subtotal      Float         @default(0)
  tax           Float         @default(0)
  discount      Float         @default(0)
  total         Float         @default(0)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  quoteId       String?
  quote         Quote?        @relation(fields: [quoteId], references: [id])
  leadId        String?
  lead          Lead?         @relation(fields: [leadId], references: [id])
  opportunityId String?
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id])
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  archivedAt    DateTime?

  items InvoiceItem[]

  @@index([leadId])
  @@index([opportunityId])
  @@index([organizationId])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name        String  @default("")
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  amount      Float   @default(0)
}

model ProspectingList {
  id            String     @id @default(uuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  name          String
  description   String?
  archived      Boolean    @default(false)
  createdById   String?
  createdBy     User?      @relation(fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  prospects Prospect[]
  campaigns CallCampaign[]

  @@index([organizationId])
}

model Prospect {
  id              String          @id @default(uuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  companyName     String?
  notes           String?
  ownerId         String?
  owner           User?           @relation(fields: [ownerId], references: [id])
  contacted       Boolean         @default(false)
  convertedAt     DateTime?
  convertedLeadId String?         @unique
  convertedLead   Lead?           @relation(fields: [convertedLeadId], references: [id])
  listId          String
  list            ProspectingList @relation(fields: [listId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  callQueueEntries CallQueueEntry[]

  @@index([listId])
}

model CallCampaign {
  id            String   @id @default(uuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  name          String
  listId        String?
  list          ProspectingList? @relation(fields: [listId], references: [id])
  startDate     DateTime?
  endDate       DateTime?
  status        String   @default("Draft")
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  queue CallQueueEntry[]

  @@index([organizationId])
}

model CallQueueEntry {
  id            String      @id @default(uuid())
  campaignId    String
  campaign      CallCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospectId    String?
  prospect      Prospect?   @relation(fields: [prospectId], references: [id])
  assignedToId  String?
  assignedTo    User?       @relation(fields: [assignedToId], references: [id])
  outcome       CallOutcome?
  notes         String?
  followUpDate  DateTime?
  calledAt      DateTime?
  createdAt     DateTime    @default(now())
}

model SalesGoal {
  id            String   @id @default(uuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  name          String
  metric        String
  target        Float
  period        String   @default("month")
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  startDate     DateTime
  endDate       DateTime
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([organizationId])
}

model Automation {
  id            String   @id @default(uuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  name          String
  enabled       Boolean  @default(true)
  triggerType   String
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conditions AutomationCondition[]
  actions    AutomationAction[]
  runs       AutomationRun[]

  @@index([organizationId])
}

model AutomationCondition {
  id           String      @id @default(uuid())
  automationId String
  automation   Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  field        String
  operator     String
  value        String?
}

model AutomationAction {
  id             String      @id @default(uuid())
  automationId   String
  automation     Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  type           String
  payload        Json
  position       Int         @default(0)
  graphDependent Boolean     @default(false)
}

model AutomationRun {
  id           String      @id @default(uuid())
  automationId String
  automation   Automation  @relation(fields: [automationId], references: [id])
  entityType   String
  entityId     String
  status       String      @default("running")
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?

  logs AutomationRunLog[]
}

model AutomationRunLog {
  id        String        @id @default(uuid())
  runId     String
  run       AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  level     String        @default("info")
  message   String
  createdAt DateTime      @default(now())
}

model Report {
  id            String   @id @default(uuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  name          String
  category      String
  type          String
  description   String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  lastRun       DateTime?
  status        String   @default("Draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdById])
  @@index([organizationId])
}

// ============================================================================
// SaaS multi-tenancy (Section 3–6 of the SaaS conversion)
// ============================================================================

/**
 * A customer organization/workspace. Every tenant-owned record is scoped to
 * exactly one Organization. Keyed by the authenticated Microsoft Entra tenant
 * ID (`microsoftTenantId`) when known; legacy/single-tenant data lives in the
 * seeded default organization.
 */
model Organization {
  id                 String    @id @default(uuid())
  name               String
  slug               String?   @unique
  /** Authenticated Microsoft Entra tenant ID (tid) — never derived from email. */
  microsoftTenantId  String?   @unique
  status             String    @default("ACTIVE") // ACTIVE | SUSPENDED | DISABLED
  createdById        String?
  createdBy          User?     @relation("OrganizationCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  members         OrganizationMember[]
  subscriptions   Subscription[]
  users           User[]
  companies       Company[]
  customers       Customer[]
  contacts        Contact[]
  leads           Lead[]
  opportunities   Opportunity[]
  activities      Activity[]
  calendarEvents  CalendarEvent[]
  tickets         Ticket[]
  documents       Document[]
  quotes          Quote[]
  invoices        Invoice[]
  reminders       Reminder[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  notes           Note[]
  assignments     Assignment[]
  reports         Report[]
  automations     Automation[]
  prospectingLists ProspectingList[]
  callCampaigns   CallCampaign[]
  salesGoals      SalesGoal[]
  tags            Tag[]
  salesInquiries  SalesInquiry[]
  onboardingStates OnboardingState[]

  @@index([microsoftTenantId])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

/**
 * Catalog of sellable plans. Seeded: TRIAL, STARTER, PROFESSIONAL, ENTERPRISE.
 * `features` is a snapshot of granted feature codes for reporting/UI.
 */
model Plan {
  id        String   @id @default(uuid())
  code      String   @unique // TRIAL | STARTER | PROFESSIONAL | ENTERPRISE
  name      String
  limits    Json?
  features  Json?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Central feature-flag source of truth: which features each plan grants.
 * Enforced server-side by lib/entitlements.ts — UI mirrors it for display.
 */
model Entitlement {
  id        String   @id @default(uuid())
  planCode  String
  feature   String // outlook_email | calendar_sync | teams | advanced_analytics | automation | api | ...
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([planCode, feature])
  @@index([planCode])
}

/**
 * One active subscription per organization (rows are never hard-deleted; plan
 * changes create SubscriptionChange audit rows instead).
 * Statuses: TRIALING | ACTIVE | EXPIRED | SUSPENDED | CANCELED
 * Sources:  TRIAL | MANUAL | SALES | DEMO | PARTNER | BILLING | INTERNAL
 */
model Subscription {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planCode       String       @default("TRIAL")
  status         String       @default("TRIALING")
  source         String       @default("TRIAL")
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  startsAt       DateTime?
  endsAt         DateTime?
  grantedById    String?
  grantedBy      User?        @relation("SubscriptionGrantedBy", fields: [grantedById], references: [id])
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  changes SubscriptionChange[]

  @@index([planCode])
  @@index([status])
}

/**
 * Immutable audit trail for every subscription/plan change (manual plan
 * override, trial extension/expiry, suspend/reactivate, source changes).
 * Captures changed-by, previous/new plan, source/reason and timestamp.
 */
model SubscriptionChange {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  previousPlan   String?
  newPlan        String
  previousStatus String?
  newStatus      String?
  source         String?
  reason         String?
  changedById    String?
  changedBy      User?        @relation("SubscriptionChangeBy", fields: [changedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

/**
 * Per-user onboarding progress for the SaaS first-login flow.
 */
model OnboardingState {
  id                         String       @id @default(uuid())
  userId                     String       @unique
  user                       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId             String?
  organization               Organization? @relation(fields: [organizationId], references: [id])
  currentStep                Int          @default(1)
  completed                  Boolean      @default(false)
  tourCompleted              Boolean      @default(false)
  gettingStartedDismissedAt  DateTime?
  completedAt                DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  @@index([organizationId])
}

/**
 * Self-service Request Demo / Contact Sales inquiries. Persisted immediately;
 * the Platform Owner reviews and decides (keep pending / convert to Lead /
 * create Trial workspace / grant demo / resolve). NEVER auto-creates an
 * Opportunity — that is an explicit owner action.
 */
model SalesInquiry {
  id             String        @id @default(uuid())
  name           String
  email          String
  company        String?
  phone          String?
  companySize    String?
  industry       String?
  intendedUse    String?
  preferredPlan  String?
  message        String?
  source         String        @default("WEB") // WEB | CONTACT | BOOK_DEMO | GET_STARTED | TRIAL
  status         String        @default("PENDING") // PENDING | REVIEWING | LEAD | CONVERTED | RESOLVED | REJECTED
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  reviewedById   String?
  reviewedBy     User?         @relation("SalesInquiryReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  notes          String?
  submittedAt    DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([email])
  @@index([status])
}
